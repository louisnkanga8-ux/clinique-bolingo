# Secrets et réglages locaux : ne jamais les envoyer sur GitHub.
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]

# Archives de travail : les WebP nécessaires au site restent versionnés.
# Les PNG d’origine et intermédiaires sont conservés sur le poste de travail.
/public/assets/images/**/originaux/
/public/assets/images/reference-*.png
/public/assets/images/medecins/*-bolingo.png
/public/assets/images/visuels/*-bolingo.png

# Anciennes captures remplacées par des photos individuelles.
# Attention : reference-services.webp et reference-contact-bolingo.webp sont encore utilisés.
/public/assets/images/reference-accueil*.webp
/public/assets/images/reference-apropos*.webp
/public/assets/images/reference-medecins.webp
